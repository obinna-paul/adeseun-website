# Public site
NEXT_PUBLIC_SITE_URL=https://adeseunoyeneye.com

# Existing commerce and mail
PAYSTACK_SECRET_KEY=
RESEND_API_KEY=
PRINTER_EMAIL=

# Upstash Redis (use either this pair or the Vercel Marketplace names)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Private Cloudflare R2 bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=adeseun-ebooks
R2_PREFIX=ebooks

# Reader and publisher security (use independent random values, 32+ chars)
READER_SESSION_SECRET=
EBOOK_ADMIN_SECRET=

# Free on-demand PDF processor (GitHub Actions)
GITHUB_ACTIONS_TOKEN=
GITHUB_REPOSITORY=obinna-paul/adeseun-website
GITHUB_EBOOK_WORKFLOW=process-ebook.yml
GITHUB_EBOOK_REF=main

# Optional self-hosted processor fallback (not needed for GitHub Actions)
EBOOK_PROCESSOR_URL=https://your-processor.example.com/process
EBOOK_PROCESSOR_SECRET=
PORT=8080
